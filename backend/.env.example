# Android SDK location (adb / emulator / apkanalyzer are resolved from here
# when they are not already on PATH).
ANDROID_SDK_ROOT=C:\Software\SDK\Android

# FastAPI backend port.
BACKEND_PORT=8000

# ws-scrcpy standalone web server port (its own default is 8000 — keep them apart).
WS_SCRCPY_PORT=8100
WS_SCRCPY_DIR=tools/ws-scrcpy

# AVD cold boot timeout (seconds).
BOOT_TIMEOUT_S=240

# Font scale used by the text-scaling rule (WCAG 1.4.4 probe).
FONT_SCALE_TEST_VALUE=1.3
